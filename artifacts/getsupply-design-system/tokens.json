{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "GetSupply design tokens — DTCG format. Edit values here only; never hand-edit the generated src/index.css or src/generated/tokens.tsx. Colors are hex; the generator converts them to H S% L% channels.",
  "color": {
    "$type": "color",
    "light": {
      "background":          { "$value": "#FAF5EA", "$description": "Sand/cream page background." },
      "foreground":          { "$value": "#1F1B16", "$description": "Near-black ink for body text." },
      "border":              { "$value": "#DCCFB8" },
      "card":                { "$value": "#FFFFFF" },
      "cardForeground":      { "$value": "#1F1B16" },
      "popover":             { "$value": "#FFFFFF" },
      "popoverForeground":   { "$value": "#1F1B16" },
      "primary": {
        "$value": "#C1502E",
        "$description": "Terracotta — CTA buttons, primary links, focus rings."
      },
      "primaryForeground":   { "$value": "#FFFFFF" },
      "secondary":           { "$value": "#F0E1CB", "$description": "Light beige — card backgrounds, tags, chips." },
      "secondaryForeground": { "$value": "#4A3220" },
      "muted":               { "$value": "#EDE6D5" },
      "mutedForeground":     { "$value": "#8A7565" },
      "accent":              { "$value": "#E8D9C0", "$description": "Warm beige for hover/active surfaces." },
      "accentForeground":    { "$value": "#1F1B16" },
      "destructive":         { "$value": "#B91C1C", "$description": "Danger — distinct from terracotta CTA." },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input":               { "$value": "#DCCFB8" },
      "ring":                { "$value": "#C1502E" },
      "chart1": { "$value": "#D97706", "$description": "Amber — Aguardando proposta (waiting)." },
      "chart2": { "$value": "#2563EB", "$description": "Blue — Proposta recebida (received)." },
      "chart3": { "$value": "#DC2626", "$description": "Crimson — Atrasado (delayed). Distinct from terracotta." },
      "chart4": { "$value": "#16A34A", "$description": "Green — Fechado (closed / won)." },
      "chart5": { "$value": "#7C3AED", "$description": "Violet — data visualisation fifth series." },
      "sidebar":                    { "$value": "#F5ECD9" },
      "sidebarForeground":          { "$value": "#4A3220" },
      "sidebarBorder":              { "$value": "#DCCFB8" },
      "sidebarPrimary":             { "$value": "#C1502E" },
      "sidebarPrimaryForeground":   { "$value": "#FFFFFF" },
      "sidebarAccent":              { "$value": "#EDE6D5" },
      "sidebarAccentForeground":    { "$value": "#1F1B16" },
      "sidebarRing":                { "$value": "#C1502E" }
    },
    "dark": {
      "background":          { "$value": "#1B1510" },
      "foreground":          { "$value": "#EFE7D4" },
      "border":              { "$value": "#3A2D1F" },
      "card":                { "$value": "#231A13" },
      "cardForeground":      { "$value": "#EFE7D4" },
      "popover":             { "$value": "#231A13" },
      "popoverForeground":   { "$value": "#EFE7D4" },
      "primary":             { "$value": "#D46040", "$description": "Lighter terracotta for dark mode legibility." },
      "primaryForeground":   { "$value": "#FFFFFF" },
      "secondary":           { "$value": "#2C2017" },
      "secondaryForeground": { "$value": "#D4C4AC" },
      "muted":               { "$value": "#2C2017" },
      "mutedForeground":     { "$value": "#A08870" },
      "accent":              { "$value": "#372A1D" },
      "accentForeground":    { "$value": "#EFE7D4" },
      "destructive":         { "$value": "#C0392B" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input":               { "$value": "#3A2D1F" },
      "ring":                { "$value": "#D46040" },
      "chart1": { "$value": "#F59E0B" },
      "chart2": { "$value": "#60A5FA" },
      "chart3": { "$value": "#F87171" },
      "chart4": { "$value": "#4ADE80" },
      "chart5": { "$value": "#A78BFA" },
      "sidebar":                    { "$value": "#141009" },
      "sidebarForeground":          { "$value": "#C8B898" },
      "sidebarBorder":              { "$value": "#3A2D1F" },
      "sidebarPrimary":             { "$value": "#D46040" },
      "sidebarPrimaryForeground":   { "$value": "#FFFFFF" },
      "sidebarAccent":              { "$value": "#2C2017" },
      "sidebarAccentForeground":    { "$value": "#EFE7D4" },
      "sidebarRing":                { "$value": "#D46040" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Plus Jakarta Sans", "sans-serif"], "$description": "Warm, e-commerce-grade primary font." },
      "serif": { "$value": ["Lora", "serif"] },
      "mono":  { "$value": ["JetBrains Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.625rem", "$description": "10 px base; sm/md/lg/xl derive from it. Keeps the warm, approachable feel." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "4 px base step." }
  }
}
